{
  "name": "smec-uae-html",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SMEC Technologies UAE course landing page – static HTML build",
  "scripts": {
    "build:html": "node src/generate.mjs",
    "build:css": "tailwindcss -i src/styles.css -o assets/css/styles.css --minify",
    "build": "npm run build:html && npm run build:css",
    "watch:css": "tailwindcss -i src/styles.css -o assets/css/styles.css --watch",
    "serve": "python -m http.server 3222"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-static": "^1.45.0",
    "tailwindcss": "^4.3.3"
  }
}
